{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "/usr/share/pixmaps/himal-logo-256.png", "padding": { "top": 1, "left": 2 } },
  "display": { "separator": "  ", "color": { "keys": "34" } },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    { "type": "custom", "format": "Build by Samir Puri" }
  ]
}
